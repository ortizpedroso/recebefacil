# Sem DATABASE_URL, o app grava em PGlite na pasta data/recebefacil.
# Com DATABASE_URL, o app usa o Postgres.
# Obrigatória em produção, com pelo menos 32 caracteres. Assina os links de pagamento e cifra as credenciais do Asaas.
# RECEBEFACIL_SECRET=
# E-mails (separados por vírgula) que podem abrir a página Plataforma.
# PLATFORM_OWNER_EMAILS=
# Não coloque chave nem token do Asaas aqui. Eles são digitados na página Plataforma e ficam cifrados no banco.
